{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.15.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "gren@0.6",
    "nodePackages.prettier@latest"
  ],
  "shell": {
    "scripts": {
      "build": [
        "gren make"
      ],
      "format": "prettier -w \"**/*.{js,mjs}\"",
      "format:check": "prettier -c \"**/*.{js,mjs}\"",
      "doc:preview": "npx -y --package gren-packages gren-doc-preview",
      "test": [
        "devbox run test:unit",
        "devbox run test:integration"
      ],
      "test:unit": [
        "cd tests/",
        "gren run Main"
      ],
      "test:integration": [
        "cd integration-tests/",
        "make test"
      ]
    }
  }
}
